# Copy this file to .env and edit it. Never commit .env or real keys.
#
# Administrative functions (uploads, verification, backups, audit log) stay disabled until
# ADMIN_API_KEY is set. Use a long random value, at least 32 characters.
ADMIN_API_KEY=

# Leave blank to use data/planner.db. PostgreSQL works through SQLAlchemy but is not tested in this build.
DATABASE_URL=

# The planner shows the time of day in the service area's time zone. An imported feed names its own zone
# (agency_timezone), and that zone is used. This value is the fallback when no feed is loaded.
# Use an IANA name such as Asia/Kolkata, Europe/London or America/New_York.
SERVICE_TIMEZONE=Asia/Kolkata

# Optional: a TrueType (.ttf) file for PDF exports, for characters that the built-in font lacks.
# The PDF writer does not shape Indic, Arabic or Thai text, so it cannot show those scripts correctly.
PDF_FONT_PATH=

MAX_UPLOAD_MB=100
MAX_UNCOMPRESSED_MB=500
MAX_ZIP_MEMBERS=50
MAX_COMPRESSION_RATIO=100
RATE_LIMIT_PER_MINUTE=120

# Estimate assumptions for future scenarios. These are placeholders to calibrate, not measured values.
AVG_BUS_SPEED_KMPH=15
STOP_DWELL_MINUTES=0.5
DETOUR_FACTOR=1.3

# Journey planning assumptions. Every journey result shows them. The minimum time for a change (minutes), the longest
# walk between stops of one classification (metres) and the walking speed (km/h) are planning estimates, not measurements.
MIN_TRANSFER_MINUTES=3
MAX_TRANSFER_WALK_M=300
WALK_SPEED_KMPH=4.8

# Blank uses data/backups.
BACKUP_DIR=
LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API from another website. Blank allows none.
CORS_ORIGINS=

# Docker only (docker-compose.yml and deploy/Caddyfile): the public host name that Caddy serves over HTTPS,
# for example planner.example.org. Leave blank when running without Docker.
PLANNER_DOMAIN=
